#include <iostream>
#include <string>
using namespace std;

class Product {
private:
    int id;
    string name;
    float price;

public:
    // Constructor: initializes id, name, and price
    Product(int i, const string& n, float p) : id(i), name(n), price(p) {
        cout << "Constructor called" << endl;
    }

    // Destructor: runs when the object goes out of scope
    ~Product() {
        cout << "Destructor called" << endl;
    }

    // Prints the product's details
    void printDetails() const {
        cout << "ID: " << id
             << ", Name: " << name
             << ", Price: $" << price
             << endl;
    }
};

int main() {
    // Create a Product object with any values you like
    Product p(101, "Notebook", 4.99f);

    // Verify data with printDetails()
    p.printDetails();

    return 0;
}
